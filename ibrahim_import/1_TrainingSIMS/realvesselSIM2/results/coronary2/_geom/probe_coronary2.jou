; ===========================================================
; probe_inlet_geom.jou  (Fluent 25.2 robust, non-interactive)
; Purpose: Read mesh (.msh) and print inlet area to transcript
; ===========================================================

/file/set-tui-version "25.2"
/file/set-batch-options yes no yes

/file/read-case "coronary2.msh"

/file/start-transcript "results/coronary2/_geom/inlet_geom_transcript.txt"

; ---- Area of inlet surface (answer prompts explicitly) ----
/report/surface-integrals/area
inlet
()
no

/file/stop-transcript
/exit yes